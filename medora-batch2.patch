@@ -0,0 +1,30 @@
+package com.example.medora.ui.theme
+
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.graphics.Color
+
+// Soft fills used only to tell cards apart (subjects, small stat cards).
+// The main color stays MEDORA blue. Text on a pastel uses its own content color.
+object MedoraPastel {
+    class Tone(val container: Color, val content: Color)
+
+    private val light = listOf(
+        Tone(Color(0xFFD6F5E3), MedoraColors.Ink), // mint
+        Tone(Color(0xFFE6E0FA), MedoraColors.Ink), // lilac
+        Tone(Color(0xFFFFF0C2), MedoraColors.Ink), // butter
+        Tone(Color(0xFFD9F4FA), MedoraColors.Ink), // sky
+    )
+    private val dark = listOf(
+        Tone(Color(0xFF123B2B), Color(0xFFEAF6FA)),
+        Tone(Color(0xFF2A2350), Color(0xFFEAF6FA)),
+        Tone(Color(0xFF4A3B10), Color(0xFFEAF6FA)),
+        Tone(Color(0xFF0F3140), Color(0xFFEAF6FA)),
+    )
+
+    // Same index gives the same tone, so a card keeps its color.
+    @Composable
+    fun tone(index: Int): Tone {
+        val list = if (LocalMedoraDark.current) dark else light
+        return list[Math.floorMod(index, list.size)]
+    }
+}
